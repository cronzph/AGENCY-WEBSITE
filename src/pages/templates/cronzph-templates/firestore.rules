rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // DEMO COLLECTIONS - Read only, no writes
    // ============================================

    match /demo_coffee_products/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /demo_coffee_orders/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Future templates demo collections
    match /demo_pos_products/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /demo_pos_transactions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /demo_ecommerce_products/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /demo_ecommerce_orders/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================
    // CLIENT COLLECTIONS - Authenticated access
    // ============================================

    match /products/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /orders/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /categories/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
